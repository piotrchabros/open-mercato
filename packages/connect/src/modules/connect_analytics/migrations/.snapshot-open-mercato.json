          "expression": "(\n    (\"cost_type\" = 'agent' and \"user_id\" is not null and \"channel_id\" is null)\n    or (\"cost_type\" = 'channel' and \"channel_id\" is not null and \"user_id\" is null)\n    or (\"cost_type\" = 'ai' and \"user_id\" is null and \"channel_id\" is null)\n  )",
