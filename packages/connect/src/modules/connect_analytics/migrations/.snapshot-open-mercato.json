        },
        {
          "name": "connect_cost_inputs_provenance_chk",
          "expression": "(\n    (\"source\" = 'manual' and \"provider_invoice_ref\" is null and \"provider_line_ref\" is null)\n    or (\"source\" = 'provider_invoice' and \"provider_invoice_ref\" is not null and \"provider_line_ref\" is not null)\n  )",
          "definition": "check ((\n    (\"source\" = 'manual' and \"provider_invoice_ref\" is null and \"provider_line_ref\" is null)\n    or (\"source\" = 'provider_invoice' and \"provider_invoice_ref\" is not null and \"provider_line_ref\" is not null)\n  ))"
        },
        {
